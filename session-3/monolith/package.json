{
  "name": "social-monolith",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outfile=dist/server.js",
    "start:dist": "node dist/server.js",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:bulk": "tsx src/db/seed-bulk.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "1.0.0-rc.5",
    "drizzle-seed": "1.0.0-rc.5",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "1.0.0-rc.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
